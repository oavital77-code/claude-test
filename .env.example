# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WooCommerce — מקור האמת היחיד לכל תשלום (כרטיסייה + ססיה). סוד ה-webhook
# שמוגדר בחנות (Settings → Advanced → Webhooks), וכתובת החנות עצמה — כל רכישה
# מפנה לשם (התשלום מתבצע ב-Woo, לא ב-Cleana). מיפוי Product ID → כרטיסייה
# בטבלת woo_product_tiers; Product ID של הססיה ב-app_settings.woo_session_product_id
# (נערך דרך /admin/settings).
WOOCOMMERCE_WEBHOOK_SECRET=
NEXT_PUBLIC_WOOCOMMERCE_STORE_URL=https://baclinica.co.il

# כתובת בסיס לקישורי מייל/ICS
NEXT_PUBLIC_APP_URL=https://app.baclinica.co.il
