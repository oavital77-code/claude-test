# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WooCommerce — מקור האמת היחיד לכל תשלום (כרטיסייה + ססיה). כתובת החנות —
# כל רכישה מפנה לשם (התשלום מתבצע ב-Woo, לא ב-Cleana). מיפוי Product ID →
# כרטיסייה בטבלת woo_product_tiers; Product ID של הססיה ב-
# app_settings.woo_session_product_id (נערך דרך /admin/settings).
NEXT_PUBLIC_WOOCOMMERCE_STORE_URL=https://baclinica.co.il

# WOOCOMMERCE_WEBHOOK_SECRET — אופציונלי. אם אין webhook מוגדר בחנות (המצב
# הנוכחי), אפשר להשאיר ריק — הגילוי עובד דרך polling (ראה שני המשתנים הבאים).
WOOCOMMERCE_WEBHOOK_SECRET=

# WOOCOMMERCE_KEY/SECRET — מפתחות REST API (Settings → Advanced → REST API),
# הרשאת Read בלבד מספיקה (הקוד רק קורא הזמנות, אף פעם לא כותב לחנות).
# משמשים לגילוי תשלומים בפולינג כשאין webhook: בדיקה יזומה בכל טעינת עמוד
# (חלון 90 דק') + cron יומי כרשת ביטחון (חלון 26 שעות). server-only.
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# כתובת בסיס לקישורי מייל/ICS
NEXT_PUBLIC_APP_URL=https://cleana.co.il

# Sentry — ניטור שגיאות בפרודקשן (client + server + edge). DSN מ-Sentry →
# Settings → Client Keys (DSN) בפרויקט. בלי ערך — Sentry.init לא מופעל בכלל
# (ר' instrumentation.ts/instrumentation-client.ts), אז אין צורך בו בפיתוח מקומי.
NEXT_PUBLIC_SENTRY_DSN=

# שלושת אלה אופציונליים — נדרשים רק כדי שה-build (Vercel/CI) יעלה source maps
# מפוענחים ל-Sentry. בלי הם ה-build עובד רגיל, פשוט stack traces ב-Sentry
# יראו קוד minified. SENTRY_AUTH_TOKEN: Sentry → Settings → Auth Tokens
# (הרשאת project:releases בלבד מספיקה). server-only, לא NEXT_PUBLIC.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
